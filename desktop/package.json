{
  "name": "vnmap-desktop",
  "productName": "Карта новеллы",
  "version": "1.6.9",
  "description": "Конструктор визуальных новелл: карта сюжета, сценарии, ресурсы и компилятор в Ren'Py",
  "author": "Карта новеллы",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron . --dev",
    "page": "python3 ../build.py",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "python3 pack.py"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.vnmap.desktop",
    "productName": "Карта новеллы",
    "executableName": "vnmap",
    "artifactName": "VNMap-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "preload.js", "gdrive.js", "updater.js", "buildwrite.js", "renpy.js", "selfupdate.js", "notify.js", "google-oauth.json", "package.json", "app/**/*", "build/icon.png"],
    "fileAssociations": [
      { "ext": "vnmap", "name": "Проект «Карты новеллы»", "description": "Проект «Карты новеллы»", "role": "Editor", "icon": "build/icon" }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "artifactName": "VNMap-win-${arch}-setup.${ext}" },
    "portable": { "artifactName": "VNMap-win-${arch}-portable.${ext}" },
    "mac": { "target": ["dmg", "zip"], "icon": "build/icon.icns", "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Development", "mimeTypes": ["application/x-vnmap"] }
  }
}
